<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_inherit_university" model="ir.ui.view">
        <field name="name">project.project.form.university.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- Скрываем стандартные поля -->
            <xpath expr="//group[field[@name='label_tasks']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Добавляем вкладки в notebook -->
            <xpath expr="//notebook" position="inside">

                <!-- Паспорт проекта -->
                <page string="Паспорт проекта" name="university_project_passport">
                    <group>
                        <group string="Идентификация">
                            <field name="name" string="Название проекта (RU)"/>
                            <field name="name_en"/>
                            <field name="short_name"/>
                            <field name="project_type"/>
                            <field name="project_status"/>
                        </group>
                        <group string="Организация">
                            <field name="department_name"/>
                            <field name="project_owner_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>

                    <group string="Ключевые ссылки" col="2">
                        <field name="link_repo"/>
                        <field name="link_docs"/>
                        <field name="link_design"/>
                        <field name="link_chat"/>
                        <field name="link_meeting"/>
                    </group>
                </page>

                <!-- Команда -->
                <page string="Команда" name="university_project_team">
                    <group>
                        <field name="member_ids" context="{'default_project_id': id}">
                            <list editable="bottom">
                                <field name="user_id"/>
                                <field name="role_id"/>
                            </list>
                            <form>
                                <group>
                                    <field name="project_id" readonly="1"/>
                                    <field name="user_id"/>
                                    <field name="role_id"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>

                <!-- Вложения -->
                <page string="Вложения" name="university_project_documents">
                    <group>
                        <field name="document_ids" context="{'default_project_id': id}">
                            
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="file_data" filename="file_name"/> 
                            </list>
                            
                            <form>
                                <group>
                                    <field name="project_id" readonly="1"/>
                                    <field name="name"/>
                                    <field name="file_data" filename="file_name" widget="binary"/>
                                </group>
                            </form>
                            
                        </field>
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>
